#!/usr/bin/env bash
#
# Saorsa Labs - Rust Pre-Commit Hook
# ==================================
# Ensures code quality before commits in Rust workspaces.
#
# Installation (from the repo root):
#   git config core.hooksPath .githooks   # or: just hooks-install
#
# Required tools (will error if missing):
#   - just:              Task runner (hakari recipes enforce the pinned version)
#   - cargo-hakari:      Unifies workspace deps (version-pinned, see justfile)
#   - cargo-machete:     Finds unused dependencies
#
# Recommended tools (will warn if missing):
#   - cargo-semver-checks: Validates semver compatibility (run before releases)
#   - cargo-mutants: Mutation testing for test quality (run in CI)
#

set -e

# Colors
RED='\033[0;31m'
GREEN='\033[0;32m'
YELLOW='\033[1;33m'
BLUE='\033[0;34m'
CYAN='\033[0;36m'
NC='\033[0m' # No Color
BOLD='\033[1m'

# Counters
ERRORS=0
WARNINGS=0

print_header() {
    echo -e "\n${BLUE}━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━${NC}"
    echo -e "${BOLD}${CYAN}🦀 Saorsa Labs Rust Pre-Commit Hook${NC}"
    echo -e "${BLUE}━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━${NC}\n"
}

print_section() {
    echo -e "${BOLD}▶ $1${NC}"
}

print_pass() {
    echo -e "  ${GREEN}✓${NC} $1"
}

print_fail() {
    echo -e "  ${RED}✗${NC} $1"
    ERRORS=$((ERRORS + 1))
}

print_warn() {
    echo -e "  ${YELLOW}⚠${NC} $1"
    WARNINGS=$((WARNINGS + 1))
}

print_info() {
    echo -e "  ${BLUE}ℹ${NC} $1"
}

check_tool() {
    local tool="$1"
    local required="$2"
    local description="$3"
    local install_cmd="$4"

    if command -v "$tool" &>/dev/null; then
        return 0
    else
        if [ "$required" = "true" ]; then
            print_fail "$tool not found - $description"
            echo -e "      ${CYAN}Install: $install_cmd${NC}"
            return 1
        else
            print_warn "$tool not found (optional) - $description"
            echo -e "      ${CYAN}Install: $install_cmd${NC}"
            return 0
        fi
    fi
}

# Skip if not in a git repo
if ! git rev-parse --is-inside-work-tree &>/dev/null; then
    exit 0
fi

# Skip if no Cargo.toml (not a Rust project)
if [ ! -f "Cargo.toml" ]; then
    exit 0
fi

print_header

# =============================================================================
# TOOL AVAILABILITY CHECK
# =============================================================================
print_section "Checking required tools..."

TOOLS_OK=true

# Required tools
if ! check_tool "cargo-hakari" "true" \
    "Unifies workspace deps for faster builds" \
    "cargo install cargo-hakari --version 0.9.38 --locked (pinned; see justfile)"; then
    TOOLS_OK=false
fi

if ! check_tool "cargo-machete" "true" \
    "Finds unused dependencies" \
    "cargo install cargo-machete"; then
    TOOLS_OK=false
fi

if ! check_tool "just" "true" \
    "Task runner (hakari recipes enforce the pinned cargo-hakari version)" \
    "brew install just  # or: cargo install just"; then
    TOOLS_OK=false
fi

# Recommended tools (warn only)
echo ""
print_section "Checking recommended tools..."

check_tool "cargo-semver-checks" "false" \
    "Validates semver compatibility before releases" \
    "cargo install cargo-semver-checks"

check_tool "cargo-mutants" "false" \
    "Mutation testing for test quality (run in CI)" \
    "cargo install cargo-mutants"

check_tool "cargo-nextest" "false" \
    "Faster test runner with better output" \
    "cargo install cargo-nextest"

check_tool "cargo-deny" "false" \
    "Checks dependencies for security advisories" \
    "cargo install cargo-deny"

if [ "$TOOLS_OK" = false ]; then
    echo ""
    echo -e "${RED}━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━${NC}"
    echo -e "${RED}${BOLD}COMMIT BLOCKED: Required tools missing${NC}"
    echo -e "${RED}━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━${NC}"
    echo ""
    echo -e "Install the pinned cargo-hakari with:"
    echo -e "${CYAN}  cargo install cargo-hakari --version 0.9.38 --locked${NC}"
    echo -e "Install the other recommended tools with:"
    echo -e "${CYAN}  cargo install cargo-machete cargo-nextest cargo-deny cargo-semver-checks cargo-mutants${NC}"
    echo ""
    exit 1
fi

# =============================================================================
# MACHETE CHECK (unused dependencies)
# =============================================================================
echo ""
print_section "Running cargo machete (unused dependencies)..."

MACHETE_OUTPUT=$(cargo machete 2>&1 || true)

if echo "$MACHETE_OUTPUT" | grep -q "no unused dependencies"; then
    print_pass "No unused dependencies found"
elif echo "$MACHETE_OUTPUT" | grep -q "unused dependencies"; then
    print_warn "Unused dependencies found:"
    echo "$MACHETE_OUTPUT" | grep -A 100 "unused dependencies" | head -20 | sed 's/^/      /'
    echo ""
    echo -e "      ${CYAN}Run 'cargo machete --fix' to remove them${NC}"
else
    print_pass "cargo machete check passed"
fi

# =============================================================================
# FORMAT CHECK
# =============================================================================
echo ""
print_section "Running cargo fmt --check..."

if cargo fmt --all -- --check 2>/dev/null; then
    print_pass "Code formatting is correct"
else
    print_fail "Formatting issues found - run: cargo fmt --all"
fi

# =============================================================================
# CLIPPY CHECK
# =============================================================================
echo ""
print_section "Running cargo clippy..."

CLIPPY_OUTPUT=$(cargo clippy --all-features -- -D warnings 2>&1 || true)
CLIPPY_ERRORS=$(echo "$CLIPPY_OUTPUT" | grep -c "^error" || true)

if [ "$CLIPPY_ERRORS" -eq 0 ]; then
    print_pass "cargo clippy passed"
else
    print_fail "cargo clippy found $CLIPPY_ERRORS errors"
    echo "$CLIPPY_OUTPUT" | grep "^error" | head -10 | sed 's/^/      /'
fi

# =============================================================================
# PANIC SCAN (production code only)
# =============================================================================
echo ""
print_section "Scanning for forbidden patterns in production code..."

PANIC_PATTERNS=0

# Check for unwrap/expect in src/ (excluding tests)
if [ -d "src" ]; then
    UNWRAP_COUNT=$(grep -r "\.unwrap()\|\.expect(" src/ --include="*.rs" 2>/dev/null | grep -v "#\[cfg(test)\]" | grep -v "#\[test\]" | grep -v "// allowed" | wc -l | tr -d ' ' || echo "0")
    if [ "$UNWRAP_COUNT" -gt 0 ]; then
        print_warn "Found $UNWRAP_COUNT unwrap/expect in src/ (review if in production code)"
        PANIC_PATTERNS=$((PANIC_PATTERNS + UNWRAP_COUNT))
    fi
fi

# Check for panic! in src/
if [ -d "src" ]; then
    PANIC_COUNT=$(grep -r "panic!(" src/ --include="*.rs" 2>/dev/null | grep -v "#\[cfg(test)\]" | grep -v "#\[test\]" | wc -l | tr -d ' ' || echo "0")
    if [ "$PANIC_COUNT" -gt 0 ]; then
        print_warn "Found $PANIC_COUNT panic!() in src/"
        PANIC_PATTERNS=$((PANIC_PATTERNS + PANIC_COUNT))
    fi
fi

if [ "$PANIC_PATTERNS" -eq 0 ]; then
    print_pass "No forbidden patterns found"
fi

# =============================================================================
# SUMMARY
# =============================================================================
echo ""
echo -e "${BLUE}━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━${NC}"

if [ "$ERRORS" -gt 0 ]; then
    echo -e "${RED}${BOLD}PRE-COMMIT FAILED${NC} - $ERRORS error(s), $WARNINGS warning(s)"
    echo -e "${BLUE}━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━${NC}"
    echo ""
    echo -e "Fix the errors above and try again."
    echo -e "To bypass (not recommended): ${CYAN}git commit --no-verify${NC}"
    echo ""
    exit 1
elif [ "$WARNINGS" -gt 0 ]; then
    echo -e "${YELLOW}${BOLD}PRE-COMMIT PASSED WITH WARNINGS${NC} - $WARNINGS warning(s)"
    echo -e "${BLUE}━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━${NC}"
    echo ""
else
    echo -e "${GREEN}${BOLD}PRE-COMMIT PASSED${NC}"
    echo -e "${BLUE}━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━${NC}"
    echo ""
fi

exit 0
